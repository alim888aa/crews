{
  "name": "crews",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "main": "build/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.backend.json",
    "build": "npm run check && node --import tsx scripts/build.ts && vite build",
    "start": "electron .",
    "package:mac": "npm run build && node --import tsx scripts/package-mac.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write backend shared electron scripts tests src/App.tsx src/Connections.tsx src/store.ts src/main.tsx",
    "test:images": "esbuild tests/electron-images.ts --bundle --platform=node --format=esm --external:electron --outfile=build-tests/test-images.mjs && electron build-tests/test-images.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "effect": "^3.22.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "description": "Slack for your Codex threads.",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
